# ==============================================================================
# RIDIS — Sistema de Gestão de Discos USB, Matrizes e Relatórios
# UNIDADE DE SERVIÇO SYSTEMD COM SANDBOXING E ISOLAMENTO DE SEGURANÇA
# Diretório de Instalação: /opt/app_usb/ (Ambiente Interno DGLAB)
# Servidor Autónomo: Node.js / Express em porta 3005 (Sem Proxy / Sem Nginx)
# Conformidade: ISO/IEC 27001:2022 (A.8.2, A.8.9) & Diretiva NIS 2 (Art. 21.º)
# Localização no SO: /etc/systemd/system/ridis.service
# ==============================================================================

[Unit]
Description=RIDIS — Sistema de Gestão de Discos USB e Preservação Digital (DGLAB)
Documentation=https://ridis.dglab.gov.pt
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple

# Princípio do Menor Privilégio: Utilizador dedicado sem privilégios de root
User=ridis
Group=ridis

# Diretório base homologado
WorkingDirectory=/opt/app_usb
Environment=NODE_ENV=production
Environment=APP_PORT=3005
EnvironmentFile=-/opt/app_usb/.env

# Execução autónoma via Node.js nativo (servidor Express com Vite embutido)
ExecStart=/usr/bin/node /opt/app_usb/node_modules/.bin/tsx /opt/app_usb/server.ts

# Continuidade de Negócio e Auto-Recuperação (NIS 2)
Restart=always
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Limites de Recursos de Sistema
LimitNOFILE=65535
TimeoutStopSec=30s

# Sandboxing de Segurança do Sistema de Ficheiros (ISO/IEC 27001 A.8.9)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true

# Diretórios com permissão de escrita estrita na base de dados, relatórios e backups
ReadWritePaths=/opt/app_usb/gestao_discos.db /opt/app_usb/gestao_discos.db-wal /opt/app_usb/gestao_discos.db-shm /opt/app_usb/relatorios /opt/app_usb/backups

# Logging estruturado para systemd-journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ridis-dglab

[Install]
WantedBy=multi-user.target
